# このファイルを terraform.tfvars に複製して値を調整する。
# terraform.tfvars は .gitignore で追跡対象外。

region       = "ap-northeast-1"
github_owner = "ojos"
github_repo  = "code-narrative"

# 空にするとアカウントIDを付与して自動命名される
tfstate_bucket_name = ""

# 当該アカウントは USD 請求(AWS Budgets は USD のみ)。約20USD≒3,000円
budget_limit_amount = "20"
budget_currency     = "USD"

notification_emails = ["aws+code-narrative@ojos.jp"]
