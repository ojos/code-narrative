# プロジェクト固有の環境変数テンプレート。
# 実ファイルは .env にコピーして値を設定する（.env は .gitignore 済み・コミットされない）。
#
#   cp .env.example .env
#   # .env を編集して値を入れる
#
# .env はワークスペース（ホストの bind mount）にあるため、コンテナをリビルドしても残る。
# ホスト OS の環境変数に依存せず、値の所在がプロジェクト内で完結する。
#
# 反映対象: ターミナル（on-attach が rc へ autoload を注入）/ scripts 配下 / loop-gate。
# scripts は load-project-env.sh を自前で source するため、非対話の実行でも解決できる。

# 本プロジェクト専用の Gemini API キー。
# scripts/gemini-review.sh（クロスモデル二段ゲートの第二意見）が使う。
# 以前は devcontainer の remoteEnv でホスト OS のキーも注入していたが、ホスト側と .env で
# 別のキーが入り、.env を source しない文脈でだけホスト側が使われていたため #68 で廃止した。
GEMINI_API_KEY=

# git identity。scripts/setup-git-identity.sh が local へ適用する。
# 未設定だと identity を適用できず、user.useConfigOnly=true のためコミットが
# exit 128 で止まる（#47）。
#
# git 自身が読む GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL は使わないこと。それらを .env に
# 置くと全ターミナルへ export され、local 設定を持たないリポジトリでも identity が
# 解決できてしまい、useConfigOnly による保護が無効になる。
GIT_IDENTITY_NAME=
GIT_IDENTITY_EMAIL=
